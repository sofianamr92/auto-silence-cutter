{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Add Remove-Video Feature",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}\\.vscode\\addRemoveVideoFeature.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Keep-Only-Horizontal-Vertical-Layouts",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}\\.vscode\\trimLayouts.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Fix-Keyboard-Shortcuts",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}\\.vscode\\fixShortcuts.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
