
{
    "version": "0.2.0",
    "configurations": [
        
        
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "AUTO SILENCE CUTTER",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/desktop_app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
